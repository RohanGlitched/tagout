# Nebius Token Factory (https://tokenfactory.nebius.com): NVIDIA Nemotron for reading, searching and notice reading
NEBIUS_API_KEY=
# Tavily (https://app.tavily.com): web search and page extract
TAVILY_API_KEY=
# Optional: model chains, comma-separated, first is tried first
# NEBIUS_AGENT_MODELS=nvidia/Nemotron-3-Ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b
# NEBIUS_READER_MODELS=nvidia/Nemotron-3-Ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b
# NEBIUS_VISION_MODELS=Qwen/Qwen3.8-27B,google/gemma-3-27b-it
# Optional: openFDA key (free, https://open.fda.gov/apis/authentication/). Without it openFDA allows 1,000 calls a day per IP,
# and a serverless host's egress IPs are shared.
# OPENFDA_API_KEY=
# Optional: production storage. Google Cloud Storage, keyless through Vercel OIDC (production uses this):
# GCS_BUCKET=
# GCS_WIF_AUDIENCE=//iam.googleapis.com/projects/<number>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
# or Vercel Blob:
# BLOB_READ_WRITE_TOKEN=
# Optional: demo budget (production: 60 checks a day, 15 per address) and the home page example
# DAILY_MODEL_CAP=60
# IP_DAILY_MODEL_CAP=15
# SHOWCASE_ID=
# The daily recall sweep (vercel.json cron, /api/cron/sweep). Vercel Cron sends it as a bearer token; the route
# refuses to run without it. Any long random string.
# CRON_SECRET=
# Optional: watches that re-check on the lite tier only, every six hours at most (comma-separated; default 5ehharz7sr)
# SHOWCASE_WATCH_IDS=
# Optional: per-check deadlines in ms (lite tier after the first, no new model call after the second)
# CHECK_SOFT_DEADLINE_MS=150000
# CHECK_DEADLINE_MS=200000
# Optional: the notice-read cache is on whenever storage is configured; "off" turns it off, "local" keeps it in .data/
# TAGOUT_READ_CACHE=
# Standalone sweep job only (scripts/sweep.mts): a short-lived GCS token instead of keyless or key auth, and a key
# prefix for trial runs
# GCS_ACCESS_TOKEN=
# SWEEP_PREFIX=sweep-test/
